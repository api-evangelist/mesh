  "info": {
    "_postman_id": "c905e53b-9924-40fa-b49f-0c6b505dda68",
    "name": "Mesh Connect Integration Assets Self Managed Account Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "\nMesh allows users to connect accounts of financial institutions,\ncrypto exchanges, and self-custody wallets. Mesh handles credential\nvalidation, MFA, and error handling for each integration. After\nan account is connected, Mesh allows client applications to read holdings,\ntransaction history and balances and execute crypto transfers (with user approval).",
      "type": "text/plain"
    }
  }
